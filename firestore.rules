          && isValidId(businessId) && isValidId(productId)
          && isValidProduct(incoming(), businessId, productId)
          && isManagerOrOwner(businessId)
          && matchesParentMembership(incoming(), businessId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified()
          && isValidId(businessId) && isValidId(productId)
          && isValidProduct(incoming(), businessId, productId)
          && incoming().ownerId == existing().ownerId
          && incoming().businessId == existing().businessId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isManagerOrOwner(businessId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'sku', 'barcode', 'category', 'brand', 'description', 'unit', 'purchaseCost', 'sellingPrice', 'currentStock', 'minStockLevel', 'supplierId', 'supplierName', 'taxRate', 'expiryDate', 'imageUrl', 'hasVariants', 'isActive', 'updatedAt']))
            || (isBusinessMember(businessId) && incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt']))
