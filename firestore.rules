          && isValidVariant(incoming(), businessId, variantId)
          && isManagerOrOwner(businessId)
          && matchesParentMembership(incoming(), businessId)
          && exists(/databases/$(database)/documents/businesses/$(businessId)/products/$(incoming().productId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified()
          && isValidId(businessId) && isValidId(variantId)
