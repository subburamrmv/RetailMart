      match /sales/{saleId} {
        allow get: if isValidId(businessId) && isValidId(saleId) && isBusinessMember(businessId);
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
