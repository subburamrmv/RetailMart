            || (existing().status == 'RECEIVED' && incoming().stockReceived == true && incoming().diff(existing()).affectedKeys().hasOnly(['amountPaid', 'outstandingAmount', 'paymentStatus', 'notes', 'updatedAt']))
          );
        allow delete: if false;
      }

      match /purchase_items/{itemId} {
