          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'description', 'amount', 'paymentMethod', 'expenseDate', 'referenceNumber', 'notes', 'updatedAt'])
            || (isOwner(businessId) && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(businessId) && isValidId(expenseId) && isOwner(businessId);
