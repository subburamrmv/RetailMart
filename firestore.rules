          && isValidSale(incoming(), businessId, saleId)
          && isBusinessMember(businessId)
          && matchesParentMembership(incoming(), businessId)
          && incoming().staffUid == request.auth.uid
          && incoming().status == 'COMPLETED'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified()
          && isValidId(businessId) && isValidId(saleId)
          && isValidSale(incoming(), businessId, saleId)
          && existing().status != 'CANCELLED'
          && incoming().ownerId == existing().ownerId
          && incoming().businessId == existing().businessId
          && incoming().staffUid == existing().staffUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isBusinessMember(businessId) && incoming().status in ['PARTIALLY_RETURNED', 'RETURNED'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'refundedAmount', 'creditAmount', 'notes', 'updatedAt']))
            || (isManagerOrOwner(businessId) && incoming().status == 'CANCELLED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'refundedAmount', 'creditAmount', 'notes', 'updatedAt']))
          );
